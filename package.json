{
  "name": "yoisho-learn",
  "version": "0.1.0",
  "description": "Adaptive Japanese Kanji & Vocabulary Learning Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:backup": "node -e \"require('fs').copyFileSync('data/yoisho.db', 'data/backup-'+new Date().toISOString().slice(0,10)+'.db')\" && echo Backup saved in data/",
    "check": "tsc --noEmit && next lint --quiet && jest --ci"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.0",
    "next": "^15.5.28",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^15.5.28",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0"
  }
}
